local Services = {
	CoreGui = game:GetService('CoreGui'),
	Players = game:GetService('Players'),
	HttpService = game:GetService('HttpService'),
	TweenService = game:GetService('TweenService'),
	UserInputService = game:GetService('UserInputService'),
	RunService = game:GetService('RunService')
}

local Configs = {}

Configs.Mouse = Services.Players.LocalPlayer:GetMouse()
Configs.Colours = {}
Configs.Colours.SectionGradient = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 24, 24)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(81, 97, 243)), ColorSequenceKeypoint.new(1, Color3.fromRGB(24, 24, 24))})
Configs.Colours.Selected = Color3.fromRGB(81, 97, 243)
Configs.Colours.UnSelected = Color3.fromRGB(100, 100, 100)

local PrivateLib = {}

function PrivateLib.Create(Class, Properties, Parent)
	local Object = Instance.new(Class)

	for Property, Value in Properties do Object[Property] = Value end
	if Parent then Object.Parent = Parent end

	return Object
end

local Library = {}

function Library.new (Name)

	print('Started'.. Name)

	local ToReturn = {}
	ToReturn.ScreenUI = PrivateLib.Create('ScreenGui', {Name = Services.HttpService:GenerateGUID(false), ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, Services.Players.LocalPlayer.PlayerGui)
	PrivateLib.Create('StringValue', {Name = 'MADE BY PizzaMuncher42 ON GITHUB', Value = Name}, ToReturn.ScreenUI)
	ToReturn.Frames = {}

	ToReturn.Frames.Main = PrivateLib.Create('ImageLabel', {Image = 'http://www.roblox.com/asset/?id=7300333488', Size = UDim2.new(0.6, 0, 0.6, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5)}, ToReturn.ScreenUI)
	PrivateLib.Create('UIAspectRatioConstraint', {AspectRatio = 1.4}, ToReturn.Frames.Main)
	PrivateLib.Create('UIDragDetector', {}, ToReturn.Frames.Main)

	ToReturn.Frames.Title = PrivateLib.Create('TextLabel', {Size = UDim2.new(0.956, 0, 0.032, 0), Position = UDim2.new(0.5, 0, 0.03, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), TextSize = 14, Font = Enum.Font.Ubuntu, TextXAlignment = Enum.TextXAlignment.Left, Text = Name}, ToReturn.Frames.Main)

	ToReturn.Frames.Tabs = PrivateLib.Create('Frame', {Size = UDim2.new(0.109, 0, 0.894, 0), Position = UDim2.new(0.017, 0, 0.082, 0), BackgroundTransparency = 1}, ToReturn.Frames.Main)
	PrivateLib.Create('UIListLayout', {HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.Name}, ToReturn.Frames.Tabs)
	ToReturn.Frames.DisplayTab = PrivateLib.Create('Frame', {Size = UDim2.new(0.837, 0, 0.892, 0), Position = UDim2.new(0.146, 0, 0.084, 0), BackgroundTransparency = 1}, ToReturn.Frames.Main)

	ToReturn.Functions = {}
	ToReturn.Tabs = {Amount = 0, Selected = 1, Frames = {Tabs = {}, Displays = {}}}
	
	function ToReturn.Functions.AddTab (Variable, Media)
		ToReturn.Tabs.Amount += 1
		local Id = ToReturn.Tabs.Amount
		local Tab = {}
		local Sections = {Amount = 0, Selected = 1, Frames = {Sections = {}, Containers = {}}}
		if Media == 'Image' then Tab.Button = PrivateLib.Create('ImageButton', {Name = Id, Size = UDim2.new(0.9, 0, 0.9, 0), BackgroundTransparency = 1, Image = Variable}, ToReturn.Frames.Tabs)
		elseif Media == 'Text' then Tab.Button = PrivateLib.Create('TextButton', {Name = Id, Size = UDim2.new(0.9, 0, 0.9, 0), BackgroundTransparency = 1, Font = Enum.Font.Ubuntu, TextSize = 20, Text = Variable}, ToReturn.Frames.Tabs) end
		PrivateLib.Create('UIAspectRatioConstraint', {}, Tab.Button)
		
		local Display = {}
		Display.TabDisplay = PrivateLib.Create('CanvasGroup', {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1}, ToReturn.Frames.DisplayTab)
		Display.SectionTab = PrivateLib.Create('Frame', {Size = UDim2.new(1, 0, 0.056, 0), BackgroundTransparency = 1}, Display.TabDisplay)
		PrivateLib.Create('UIListLayout', {FillDirection = Enum.FillDirection.Horizontal}, Display.SectionTab)
		
		ToReturn.Tabs.Frames.Tabs[Id] = Tab
		ToReturn.Tabs.Frames.Displays[Id] = Display
		
		if Id == ToReturn.Tabs.Selected then
			Display.TabDisplay.Visible = true
			Display.TabDisplay.GroupTransparency = 0
			if Media == 'Text' then Tab.Button.TextColor3 = Configs.Colours.Selected
			elseif Media == 'Image' then Tab.Button.ImageColor3 = Configs.Colours.Selected end
		else
			Display.TabDisplay.Visible = false
			Display.TabDisplay.GroupTransparency = 1
			if Media == 'Text' then Tab.Button.TextColor3 = Configs.Colours.UnSelected
			elseif Media == 'Image' then Tab.Button.ImageColor3 = Configs.Colours.UnSelected end
		end
		
		Tab.Functions = {}
		
		function Tab.Functions.AddSection (SubTitle)
			
			Sections.Amount += 1
			local SId = Sections.Amount
			local Section = {}
			Section.Button = PrivateLib.Create('TextButton', {BackgroundTransparency = 1, TextSize = 16, Name = SId, Font = Enum.Font.Ubuntu, Text = SubTitle}, Display.SectionTab)
			Section.Indicator = PrivateLib.Create('Frame', {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1.1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, Section.Button)

			local Container = {}
			Container.Main = PrivateLib.Create('CanvasGroup', {Size = UDim2.new(1, 0, 0.934, 0), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1}, Display.TabDisplay)
			Container.Left = PrivateLib.Create('Frame', {Size = UDim2.new(0.5, 0, 0.9, 0), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1}, Container.Main)
			PrivateLib.Create('UIListLayout', {HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0.1, 0)}, Container.Left)
			Container.Right = PrivateLib.Create('Frame', {Size = UDim2.new(0.5, 0, 0.9, 0), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1}, Container.Main)
			PrivateLib.Create('UIListLayout', {HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0.1, 0)}, Container.Right)

			PrivateLib.Create('UIGradient', {Color = Configs.Colours.SectionGradient}, Section.Indicator)

			Sections.Frames.Sections[SId] = Section
			Sections.Frames.Containers[SId] = Container

			for _, CSection in pairs(Sections.Frames.Sections) do CSection.Button.Size = UDim2.new(1/Sections.Amount, 0, 1, 0) end

			if SId == Sections.Selected then
				Container.Main.Visible = true
				Container.Main.GroupTransparency = 0
				Section.Button.TextColor3 = Configs.Colours.Selected
				Section.Indicator.Transparency = 0
			else
				Container.Main.Visible = false
				Container.Main.GroupTransparency = 1
				Section.Button.TextColor3 = Configs.Colours.UnSelected
				Section.Indicator.Transparency = 1
			end
			
			Section.Functions = {}
			
			function Section.Functions.AddSector (SectorName, Side)
				local Sector = {}
				Sector.Border = PrivateLib.Create('Frame', {Size = UDim2.new(0.9, 0, 0, 15), BackgroundColor3 = Color3.fromRGB(5, 5, 5), BorderColor3 = Color3.fromRGB(30, 30, 30)}, Container[Side])
				Sector.Container = PrivateLib.Create('Frame', {Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(10, 10, 10), BorderSizePixel = 0}, Sector.Border)
				PrivateLib.Create('UIListLayout', {HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.Name, Padding = UDim.new(0, 5)}, Sector.Container)
				Sector.Title = PrivateLib.Create('TextLabel', {Size = UDim2.new(1, 0, 0, 25), AnchorPoint = Vector2.new(0, 0.5, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), TextSize = 16, ZIndex = 2, Font = Enum.Font.Ubuntu, Text = SectorName}, Sector.Border)
				
				Sector.AddElement = {}
								
				function Sector.AddElement.Toggle (Description, Default)
					Sector.Border.Size += UDim2.new(0, 0, 0, 25)
					
					local Toggle = {}
					Toggle.Container = PrivateLib.Create('Frame', {Size = UDim2.new(0.9, 0, 0, 20), Name = #Sector.Container:GetChildren(), BackgroundTransparency = 1}, Sector.Container)
					Toggle.Button = PrivateLib.Create('TextButton', {Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), BorderColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.fromRGB(150, 150, 150), AutoButtonColor = false, Text = ""}, Toggle.Container)
					Toggle.Description = PrivateLib.Create('TextLabel', {Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(200, 200, 200), TextSize = 14, Font = Enum.Font.Ubuntu, Text = Description}, Toggle.Container)
					Toggle.Indicator = PrivateLib.Create('Frame', {Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BorderColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30)}, Toggle.Container)
					Toggle.Value = Default
					Toggle.Event = Instance.new('BindableEvent')
					if Default then Toggle.Button.BackgroundColor3 = Configs.Colours.Selected end
			
					function Toggle.TweenValue () Services.TweenService:Create(Toggle.Button, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundColor3 = Toggle.Value and Configs.Colours.Selected or Color3.fromRGB(150, 150, 150)}):Play() end
					
					function Toggle.SetValue(Value)
						if Toggle.Value ~= Value then
							Toggle.Value = Value
							Toggle.Event:Fire(Value)
							Toggle.TweenValue()
						end
					end
					
					Toggle.Button.MouseButton1Down:Connect(function() Toggle.SetValue(not Toggle.Value) end)
					
					return Toggle
				end
				
				function Sector.AddElement.Slider (Description, Default)
					Sector.Border.Size += UDim2.new(0, 0, 0, 35)
					
					local Slider = {}
					Slider.Value = math.clamp(Default, 0, 100)
					Slider.Container = PrivateLib.Create('Frame', {Size = UDim2.new(0.9, 0, 0, 30), Name = #Sector.Container:GetChildren(), BackgroundTransparency = 1}, Sector.Container)
					Slider.SliderBackground = PrivateLib.Create('Frame', {Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), BorderColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30)}, Slider.Container)
					Slider.SliderFrame = PrivateLib.Create('Frame', {Size = UDim2.new(Slider.Value/100, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(81, 97, 243)}, Slider.SliderBackground)
					Slider.SliderButton = PrivateLib.Create('TextButton', {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextTransparency = 1, ZIndex = 2}, Slider.SliderBackground)
					Slider.Title = PrivateLib.Create('TextLabel', {Size = UDim2.new(0.5, 0, 0, 15), BackgroundTransparency = 1, TextSize = 14, TextColor3 = Color3.fromRGB(200, 200, 200), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Ubuntu, Text = Description}, Slider.Container)
					Slider.Indicator = PrivateLib.Create('TextLabel', {Size = UDim2.new(0.5, 0, 0, 15), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, TextSize = 14, TextColor3 = Color3.fromRGB(200, 200, 200), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.Ubuntu, Text = Slider.Value}, Slider.Container)
					Slider.Event = Instance.new('BindableEvent')
				
					function Slider.Update (Value)
						local PreviousValue = Slider.Value
						if Value ~= PreviousValue then
							Slider.Event:Fire(Value*100)
							Slider.Value = Value
							Slider.Indicator.Text = math.floor(Value * 100)
							Slider.SliderFrame.Size = UDim2.new(Value, 0, 1, 0)
						end
					end
				
					Slider.SliderButton.MouseButton1Down:Connect(function()
						local Update = Services.RunService.RenderStepped:Connect(function() Slider.Update(math.clamp(((Configs.Mouse.X - Slider.SliderBackground.AbsolutePosition.X) / Slider.SliderBackground.AbsoluteSize.X),0,1)) end)
						Services.UserInputService.InputEnded:Connect(function(Input) if Input.UserInputType == Enum.UserInputType.MouseButton1 then Update:Disconnect() end end)
					end)
					
					return Slider
				end
				
				function Sector.AddElement.Button (Description)
					Sector.Border.Size += UDim2.new(0, 0, 0, 30)
					
					local Button = {}
					Button.Button = PrivateLib.Create('TextButton', {Size = UDim2.new(0.9, 0, 0, 25), BorderColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.fromRGB(200, 200, 200), Name = #Sector.Container:GetChildren(), Font = Enum.Font.Ubuntu, TextSize = 14, Text = Description}, Sector.Container)
					Button.Event = Instance.new('BindableEvent')
					
					Button.Button.MouseButton1Down:Connect(function() Button.Event:Fire() end)
					return Button
				end
				
				function Sector.AddElement.DropDown (Default, Options)
					Sector.Border.Size += UDim2.new(0, 0, 0, 30)

					local DropDown = {}
					DropDown.Value = Default
					DropDown.Container = PrivateLib.Create('Frame', {Size = UDim2.new(0.9, 0, 0, 25), BorderColor3 = Color3.new(0, 0, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), Name = #Sector.Container:GetChildren()}, Sector.Container)
					DropDown.Arrow = PrivateLib.Create('ImageLabel', {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -5, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Image = 'http://www.roblox.com/asset/?id=11552476728', BackgroundTransparency = 1}, DropDown.Container)
					DropDown.Indicator = PrivateLib.Create('TextLabel', {Size = UDim2.new(0.8, 0, 1, 0), Position = UDim2.new(0.05, 0, 0, 0), TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.Ubuntu, BackgroundTransparency = 1, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Text = Default}, DropDown.Container)
					DropDown.Button = PrivateLib.Create('TextButton', {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextTransparency = 1, ZIndex = 2}, DropDown.Container)
					DropDown.OptionsContainer = PrivateLib.Create('Frame', {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 1, Visible = false}, DropDown.Container)
					DropDown.OptionListLayout = PrivateLib.Create('UIListLayout', {Padding = UDim.new(-1, 0)}, DropDown.OptionsContainer)
					DropDown.OptionsOpen = false
					DropDown.Event = Instance.new('BindableEvent')
					DropDown.Options = {}
					
					function DropDown.CloseOptions ()
						DropDown.OptionsOpen = false
						DropDown.OptionsContainer.Visible = false
						Services.TweenService:Create(DropDown.Arrow, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Rotation = 0}):Play()
					end
					
					function DropDown.OpenOptions ()
						DropDown.OptionsOpen = true
						DropDown.OptionsContainer.Visible = true
						DropDown.OptionListLayout.Padding = UDim.new(-1, 0)
						Services.TweenService:Create(DropDown.OptionListLayout, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Padding = UDim.new(0, 0)}):Play()
						Services.TweenService:Create(DropDown.Arrow, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Rotation = 180}):Play()
					end
					
					function DropDown.SetValue (Value)
						DropDown.Value = Value
						DropDown.Indicator.Text = Value
					end
					
					for Id,OptionName in pairs(Options) do
						local Option = {}
						Option.Container = PrivateLib.Create('Frame', {Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(20, 20, 20), ZIndex = Id + 1}, DropDown.OptionsContainer)
						Option.Indicator = PrivateLib.Create('TextLabel', {Size = UDim2.new(0.95, 0, 1, 0), Position = UDim2.new(0.05, 0, 0, 0), BackgroundTransparency = 1, TextSize = 14, TextColor3 = Color3.fromRGB(200, 200, 200), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Ubuntu, Text = OptionName}, Option.Container)
						Option.Button = PrivateLib.Create('TextButton', {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextTransparency = 1, ZIndex = 2}, Option.Container)
						
						DropDown.Options[Id] = Option
						
						Option.Button.MouseButton1Down:Connect(function()
							DropDown.Event:Fire(OptionName)
							DropDown.SetValue(OptionName)
							DropDown.CloseOptions()
						end)
					end
					
					DropDown.Button.MouseButton1Down:Connect(function()
						if not DropDown.OptionsOpen then DropDown.OpenOptions()
						else DropDown.CloseOptions() end end)
					
					return DropDown
				end
				
				return Sector
			end
			
			Section.Button.MouseButton1Down:Connect(function()

				Sections.Selected = SId

				for Number = 1,Sections.Amount do

					local Section = Sections.Frames.Sections[Number].Button
					local Indicator = Sections.Frames.Sections[Number].Indicator
					local CDisplay = Sections.Frames.Containers[Number].Main

					if Number ~= SId then
						Services.TweenService:Create(Section, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Configs.Colours.UnSelected}):Play()
						Services.TweenService:Create(Indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
						Services.TweenService:Create(CDisplay, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {GroupTransparency = 1}):Play()
						task.delay(0.2, function() CDisplay.Visible = false end)
					else
						CDisplay.Visible = true
						Services.TweenService:Create(Section, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Configs.Colours.Selected}):Play()
						Services.TweenService:Create(Indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()
						Services.TweenService:Create(CDisplay, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {GroupTransparency = 0}):Play()
					end
				end
			end)
			return Section
		end
		
		Tab.Button.MouseButton1Down:Connect(function()
			
			ToReturn.Tabs.Selected = Id
			
			for Number = 1,ToReturn.Tabs.Amount do

				local Tab = ToReturn.Tabs.Frames.Tabs[Number].Button
				local Display = ToReturn.Tabs.Frames.Displays[Number].TabDisplay

				if Number ~= Id then
					if Tab:IsA('TextButton') then Services.TweenService:Create(Tab, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Configs.Colours.UnSelected}):Play()
					elseif Tab:IsA('ImageButton') then Services.TweenService:Create(Tab, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {ImageColor3 = Configs.Colours.UnSelected}):Play() end
					
					Services.TweenService:Create(Display, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {GroupTransparency = 1}):Play()
					task.delay(0.2, function() Display.Visible = false end)
				else
					if Tab:IsA('TextButton') then Services.TweenService:Create(Tab, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Configs.Colours.Selected}):Play()
					elseif Tab:IsA('ImageButton') then Services.TweenService:Create(Tab, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {ImageColor3 = Configs.Colours.Selected}):Play() end
					
					Display.Visible = true
					Services.TweenService:Create(Display, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {GroupTransparency = 0}):Play()
				end
			end
		end)
		return Tab
	end
	return ToReturn
end

return Library
